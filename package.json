{
    "name": "elte-orarend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@10.33.3",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "pnpm --parallel --filter \"./apps/*\" dev",
        "dev:web": "pnpm --filter @elte-orarend/web dev",
        "dev:api": "pnpm --filter @elte-orarend/api dev",
        "build": "pnpm --filter @elte-orarend/web build",
        "build:api": "pnpm --filter @elte-orarend/api build",
        "lint": "pnpm --recursive lint",
        "typecheck": "pnpm --recursive typecheck"
    },
    "dependencies": {
        "hono": "^4.9.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.7",
        "typescript": "^5.9.2"
    }
}
